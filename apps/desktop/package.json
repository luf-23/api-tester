{
  "name": "@api-tester/desktop",
  "version": "1.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/luf-23/api-tester.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --publish never",
    "build:publish": "electron-vite build && electron-builder --publish always",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "node -e \"const{execSync}=require('child_process');if(!process.env.CI)execSync('electron-rebuild -f -w better-sqlite3',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@api-tester/domain": "workspace:*",
    "@api-tester/http-client": "workspace:*",
    "@api-tester/mock-server": "workspace:*",
    "@api-tester/shared": "workspace:*",
    "@api-tester/storage": "workspace:*",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/view": "^6.42.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@uiw/react-codemirror": "^4.25.9",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.3.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.apitester.desktop",
    "productName": "API Tester",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "artifactName": "API-Tester-Setup-${version}.${ext}"
        },
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "luf-23",
      "repo": "api-tester"
    }
  }
}
